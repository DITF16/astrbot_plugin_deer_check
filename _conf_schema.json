{
    "group_whitelist": {
        "description": "群组白名单",
        "hint": "只有在白名单里的群才能使用本插件功能，不填表示所有群都可使用。",
        "type": "list",
        "default": []
    },
    "user_blacklist": {
        "description": "用户黑名单",
        "hint": "黑名单中的用户发送的消息不会被处理。",
        "type": "list",
        "default": []
    },
    "day_start_time": {
        "description": "每天开始时间",
        "hint": "设置每天的开始时间，格式为 HH:MM，比如设置为 02:00 意味着凌晨 2 点前都算前一天。",
        "type": "string",
        "default": "00:00"
    },
    "daily_max_checkins": {
        "description": "每日最多计入次数",
        "hint": "设置每天最多计入的打卡次数，超过此数量将不再记录，设置为 0 表示无限制。",
        "type": "int",
        "default": 0,
        "slider": {
            "min": 0,
            "max": 10,
            "step": 1
        }
    },
    "monthly_max_checkins": {
        "description": "每月最多计入次数",
        "hint": "设置每月最多计入的打卡次数，超过此数量将不再记录，设置为 0 表示无限制。",
        "type": "int",
        "default": 0,
        "slider": {
            "min": 0,
            "max": 200,
            "step": 1
        }
    },
    "ranking_display_count": {
        "description": "排行展示用户数量",
        "hint": "设置排行榜显示的用户数量，默认为 10。",
        "type": "int",
        "default": 10,
        "slider": {
            "min": 1,
            "max": 30,
            "step": 1
        }
    },
    "auto_delete_last_month_data": {
        "description": "自动删除上月数据",
        "hint": "启用后每月初自动删除上月数据，禁用则保留历史数据可查看往月记录。",
        "type": "bool",
        "default": false
    },
    "enable_female_calendar": {
        "description": "启用女生日历",
        "hint": "启用后将提供女生日历功能。",
        "type": "bool",
        "default": false
    }
}